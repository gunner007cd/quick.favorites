Menu="Buttons:99"
Title="Quick Favorites"
Icon="fa-star"
---
<?php
/* Quick Favorites - global header hook.
 *
 * Menu="Buttons" is Unraid's supported mechanism for a plugin that needs to run
 * on EVERY page: the body of this file is emitted on every page render, and
 * Unraid also renders a <div class="nav-item QuickFavoritesButton util"> into the
 * navigation bar for us. favs.js then relocates that nav-item to the end of the
 * tab strip and binds the popup to it.
 *
 * Nothing here touches an Unraid core file, so it survives reboots and upgrades.
 */
$qf_conf     = "/boot/config/plugins/quick.favorites/appearance.json";
$qf_settings = @is_file($qf_conf) ? json_decode(@file_get_contents($qf_conf), true) : [];
if (!is_array($qf_settings)) $qf_settings = [];
$qf_label = $qf_settings['header_label'] ?? 'fa-star';
$qf_image = $qf_settings['header_image'] ?? '/plugins/quick.favorites/Asuka.png';
// Only a local plugin asset may be used for the navbar image. Empty disables it.
if (!is_string($qf_image) || !preg_match('~^/plugins/[A-Za-z0-9_./-]+$~', $qf_image)) $qf_image = '';
$qf_mode  = ($qf_settings['open_mode'] ?? 'click') === 'hover' ? 'hover' : 'click';
$qf_delay = (int)($qf_settings['hover_delay'] ?? 250);
if ($qf_delay < 0 || $qf_delay > 2000) $qf_delay = 250;
?>
<style>
/* Unraid's default-base.css hides label spans inside nav items:
       .nav-item a span { display: none; }
   favs.js writes a bare text node instead, but this keeps the button visible
   even if a span ends up in there. */
#menu .nav-item.qf-nav-item a span { display: inline !important; }
#menu .nav-item.qf-nav-item a {
    text-transform: none;
    white-space: nowrap;
    line-height: 1;
}

<?php if ($qf_image !== ''): ?>
/* The selected portrait is rendered on every page, without waiting for the popup. */
#menu .nav-item.qf-nav-item #qf-custom-btn {
    position: relative !important;
    display: inline-block !important;
    width: 70px !important;
    height: 40px !important;
    padding: 0 !important;
    vertical-align: middle !important;
    overflow: visible !important;
    font-size: 0 !important;
}
#menu .nav-item.qf-nav-item #qf-custom-btn > b { display: none !important; }
#menu .nav-item.qf-nav-item #qf-custom-btn::before {
    content: "";
    position: absolute;
    width: 72px;
    height: 72px;
    left: -1px;
    top: -16px;
    background: url(<?= json_encode($qf_image, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>) center / contain no-repeat;
    pointer-events: none;
}
#menu .nav-item.qf-nav-item,
#menu .nav-item.qf-nav-item:hover,
#menu .nav-item.qf-nav-item:focus,
#menu .nav-item.qf-nav-item:active,
#menu .nav-item.qf-nav-item #qf-custom-btn,
#menu .nav-item.qf-nav-item #qf-custom-btn:hover,
#menu .nav-item.qf-nav-item #qf-custom-btn:focus {
    border-bottom: none !important;
    text-decoration: none !important;
    box-shadow: none !important;
    background-image: none !important;
}
#menu .nav-item.qf-nav-item::before,
#menu .nav-item.qf-nav-item::after {
    display: none !important;
}
/* No alternate hover image or panic state. */
<?php endif; ?>

/* Keep the pop-up out of sight from the very first paint.
   This lives in <head>, so it is parsed before any page content and long before
   favs.js injects the menu. popup.php carries its own "display:none" rule too,
   but relying on an injected stylesheet alone once let the raw menu paint at
   full size for a frame - the icons flashing during page loads.
   Visibility is driven by the .qf-open / .qf-visible classes instead. */
#qf-popup-host { display: none; }
#qf-popup-host.qf-visible { display: block; }
#my-custom-fav-menu { display: none !important; }
#my-custom-fav-menu.qf-open { display: block !important; }
</style>
<script>
window.qf_settings = {
  label: <?= json_encode((string)$qf_label, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
  open_mode: <?= json_encode($qf_mode) ?>,
  hover_delay: <?= (int)$qf_delay ?>
};
/* Unraid renders onclick="QuickFavoritesButton()" on the nav item. Define it up
   front so an early click before favs.js binds still opens the menu. */
function QuickFavoritesButton() {
  if (window.qfToggleMenu) window.qfToggleMenu();
  return false;
}
</script>
<?php
// A stale favs.js from the browser cache can leave new QF actions inert.
// Use the actual script content hash to request a fresh copy after updates.
$qf_js_file = '/usr/local/emhttp/plugins/quick.favorites/favs.js';
$qf_js_revision = is_file($qf_js_file) ? hash_file('md5', $qf_js_file) : '0';
?>
<script src="/plugins/quick.favorites/favs.js?v=<?= htmlspecialchars($qf_js_revision, ENT_QUOTES) ?>"></script>
